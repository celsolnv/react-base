{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/ui/*": [
        "./src/components/ui/*"
      ],
      "@/shared/*": [
        "./src/components/shared/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/types/*": [
        "./src/types/*"
      ],
      "@/modules/*": [
        "./src/modules/*"
      ],
    },
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "allowJs": false,
    "noUnusedLocals": false,
    "strictNullChecks": false
  },
  "exclude": [
    "node_modules",
    "src/modules/template-base"
  ]
}